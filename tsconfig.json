{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "paths": {
      "assets/*": [
        "./src/assets/*"
      ],
      "commun": [
        "./src/commun/index.ts"
      ],
      "commun/*": [
        "./src/commun/*"
      ],
      "domaines/*": [
        "./src/domaines/*"
      ],
      "modele/*": [
        "./src/modele/*"
      ],
      "modules/*": [
        "./src/modules/*"
      ],
      "waxant": [
        "./src/waxant/index.ts"
      ],
      "waxant/*": [
        "./src/waxant/*"
      ]
    },
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitAny": false
  },
  "exclude": [
    "dist",
    "node_modules"
  ]
}